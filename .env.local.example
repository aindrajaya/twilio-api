# Twilio Configuration
ACCOUNT_SID=your_twilio_account_sid_here
AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_YOUR_PHONE_NUMBER=+1234567890

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# For development - replace with your actual ngrok URL when testing
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Replace with your actual credentials:
# 1. Go to https://console.twilio.com/
# 2. Get your Account SID and Auth Token from the Dashboard
# 3. Purchase a Twilio phone number or use your trial number
# 4. Add your personal phone number (where you want to receive calls/SMS)
# 5. Go to https://elevenlabs.io/
# 6. Get your API key from Settings > API Keys
# 7. Create a conversational AI agent and get the Agent ID